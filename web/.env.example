# Copy to `.env.local` for local production-like builds, or set in Vercel project settings.
# Vite inlines VITE_* at build time — rebuild after any change.
#
# Backend origin only (no trailing slash, no /api prefix).
# Dev uses Vite proxy (/api → localhost); production talks to Render directly.
VITE_API_BASE=https://wishlist-api.onrender.com
