{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://myntra-ai-discovery-engine.onrender.com/:path*"
    },
    {
      "source": "/dashboard-bootstrap.json",
      "destination": "/dashboard-bootstrap.json"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
