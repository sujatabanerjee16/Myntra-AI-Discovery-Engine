# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Application
APP_NAME="Wishlist Conversion Discovery Engine"
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# Database (PostgreSQL + pgvector)
# Matches defaults in docker-compose.yml
POSTGRES_USER=discovery
POSTGRES_PASSWORD=discovery
POSTGRES_DB=discovery
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Full SQLAlchemy URL (overrides the individual POSTGRES_* vars if set)
DATABASE_URL=postgresql+psycopg://discovery:discovery@127.0.0.1:5432/discovery

# Embeddings (BGE)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024               # bge-large=1024, bge-base=768, bge-small=384

# LLM (Groq)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Retrieval defaults
RETRIEVAL_TOP_K=8
RAG_RERANK_TOP_K=6
RAG_MIN_CHUNKS=1
RAG_MIN_TOP_SCORE=0.38
RAG_MIN_AVG_SCORE=0.32

# Evaluation targets (Phase 6)
EVAL_RETRIEVAL_HIT_AT_K=3
EVAL_RETRIEVAL_HIT_TARGET=0.80
EVAL_FAITHFULNESS_TARGET=0.85
EVAL_TAXONOMY_ACCURACY_TARGET=0.80
EVAL_REPORT_PATH=data/eval_report.json

# Cost controls (Phase 6)
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_MAX_ENTRIES=4096
EMBEDDING_CACHE_TTL_SECONDS=86400
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_MAX_ENTRIES=512
RETRIEVAL_CACHE_TTL_SECONDS=300

# Ingestion (Phase 1)
MYNTRA_PLAY_STORE_APP_ID=com.myntra.android
RESEARCH_EXCEL_PATH=Myntra Wishlist.xlsx
PLAY_STORE_REVIEW_LIMIT=200
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SCRAPED_JSON_PATH=data/scraped_corpus.json
INSIGHTS_JSON_PATH=data/insights.json
USE_JSON_FALLBACK=true

# Phase 7 — multi-source scale-out
DEFAULT_INGESTION_SOURCES=research,play_store,reddit,youtube,product_review,social
REDDIT_SEARCH_QUERY="myntra wishlist"
REDDIT_FETCH_LIMIT=25
REDDIT_LIVE_FETCH_ENABLED=false
YOUTUBE_SEARCH_QUERY="myntra wishlist shopping"
YOUTUBE_FETCH_LIMIT=20
YOUTUBE_API_KEY=
YOUTUBE_LIVE_FETCH_ENABLED=false
PRODUCT_REVIEW_EXPORT_PATH=data/seeds/product_review.json
SOCIAL_EXPORT_PATH=data/seeds/social.json
SOURCE_REFRESH_RESEARCH_HOURS=168
SOURCE_REFRESH_PLAY_STORE_HOURS=24
SOURCE_REFRESH_REDDIT_HOURS=12
SOURCE_REFRESH_YOUTUBE_HOURS=24
SOURCE_REFRESH_PRODUCT_REVIEW_HOURS=72
SOURCE_REFRESH_SOCIAL_HOURS=12
VECTOR_BACKEND=pgvector
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=wishlist_chunks
RECOMPUTE_ANALYTICS_ON_REFRESH=true

# Phase 8 — internal data + ground-truth metric
INTERNAL_EVENTS_PATH=data/seeds/internal_wishlist_events.json
CONVERSION_WINDOW_DAYS=30
STREAMING_INGESTION_ENABLED=false
